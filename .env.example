# Local builds with ci/build.sh. Deployments use the .env in their deploy/ folder.
PWNED_REGISTRY=ghcr.io
PWNED_IMAGE_NAMESPACE=chainfirelabs/testpassword
PWNED_IMAGE_TAG=latest

# CLI only: source this file into your shell to use this setting.
# Set true to accept self-signed/untrusted HTTPS certificates.
TESTPASSWORD_TLS_INSECURE=false
