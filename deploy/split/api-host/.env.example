# Images are pulled, never built here. See the top-level README for building.
PWNED_REGISTRY=ghcr.io
PWNED_IMAGE_NAMESPACE=chainfirelabs/testpassword
PWNED_IMAGE_TAG=latest

# Interface for the web UI on 80/443. Keep loopback until a real certificate is in place.
PWNED_WEB_BIND=127.0.0.1

# Required. The data host's Traefik address, and the same keys as the data host.
PWNED_S3_ENDPOINT=https://data.example.com:8333
PWNED_S3_ACCESS_KEY=
PWNED_S3_SECRET_KEY=
PWNED_S3_BUCKET=pwned
