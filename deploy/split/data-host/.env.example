# Images are pulled, never built here. See the top-level README for building.
PWNED_REGISTRY=ghcr.io
PWNED_IMAGE_NAMESPACE=chainfirelabs/testpassword
PWNED_IMAGE_TAG=latest

# Downloads and uploads run as this user; ./data must be writable by it.
PWNED_UID=1000
PWNED_GID=1000

# Required. The same keys configure SeaweedFS and every client of it, including
# the API host.
PWNED_S3_ACCESS_KEY=
PWNED_S3_SECRET_KEY=
PWNED_S3_BUCKET=pwned

# Where Traefik publishes S3 over HTTPS. Firewall it to the API host.
PWNED_S3_BIND=0.0.0.0
PWNED_S3_PORT=8333
